# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Empty DATABASE_URL: in-memory repository (no database needed to try the HTTP contract).
DATABASE_URL=jdbc:postgresql://localhost:5432/barbersaas
DATABASE_USER=identity_auth_app
DATABASE_PASSWORD=
# PKCS#8 PEM, one line with \n escapes. barber-saas-infra/scripts/dev-keys.sh generates a development one.
JWT_PRIVATE_KEY=
JWT_KID=dev-1
JWT_LIFETIME_SECONDS=86400
BCRYPT_STRENGTH=10
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
